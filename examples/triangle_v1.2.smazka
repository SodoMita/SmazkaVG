# ═══════════════════════════════════════════════════════════
# SmazkaVG v1.2 — Triangle with Curved Edge
# ═══════════════════════════════════════════════════════════
# Demonstrates: face fill with mixed straight/curved edges

# ── Vertices ──────────────────────────────────────────────
v 0 0 0
v 1 100 0
v 2 50 86

# ─ Edges ─────────────────────────────────────────────────
e 0 0 1              # Bottom edge: straight
e 1 1 2 type=cubic 80 30 60 70   # Right edge: cubic Bézier
e 2 0 2              # Left edge: straight

# ── Faces ─────────────────────────────────────────────────
f 0 0 1 2            # Triangle: e0, e1, e2

# ── Strokes ───────────────────────────────────────────────
s 0 0 0000FF 3.0 3.0       # Bottom stroke: constant blue
s 1 1 FF0000 1.0 4.0 1.0   # Curved stroke: tapered red

# ── Paint ─────────────────────────────────────────────────
p 0 solid_fill 0 F0F0FF    # Light blue fill
