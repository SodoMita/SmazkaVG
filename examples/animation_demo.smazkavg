# Animation demo (v1.5): a square that jumps in an arc while spinning.
# Keyframes drive node transforms; render with:
#   smazka-raster animation_demo.smazka 320 240 --anim 12 24 --loop --out anim
#   -> anim_000.png ... anim_023.png + anim.gif
v 0 0 0
v 1 40 0
v 2 40 40
v 3 0 40
e 0 0 1
e 1 1 2
e 2 2 3
e 3 3 0
f 0 0 1 2 3 FF6B6B
s 0 0 8B2E2E 3 3
s 1 1 8B2E2E 3 3
s 2 2 8B2E2E 3 3
s 3 3 8B2E2E 3 3
z 0 100 120 60 60 0 F5F0E6 00000000 0      # static halo behind the ball
n 0 content=0
n 1 content=1
n 2 content=2
n 3 content=3
k 0 0 0.0 tx=0   ty=0  rot=0
k 1 0 1.0 tx=100 ty=-90 rot=3.1416
k 2 0 2.0 tx=200 ty=0  rot=6.2832
k 3 1 0.0 tx=0   ty=0  rot=0
k 4 1 1.0 tx=100 ty=-90 rot=3.1416
k 5 1 2.0 tx=200 ty=0  rot=6.2832
k 6 2 0.0 tx=0   ty=0  rot=0
k 7 2 1.0 tx=100 ty=-90 rot=3.1416
k 8 2 2.0 tx=200 ty=0  rot=6.2832
k 9  3 0.0 tx=0   ty=0  rot=0
k 10 3 1.0 tx=100 ty=-90 rot=3.1416
k 11 3 2.0 tx=200 ty=0  rot=6.2832
