# SmazkaVG v1.3 — curve showcase
# Tests all curve types with geometry that stays in-view

v 0 0 0
v 1 200 0
v 2 400 0
v 3 100 100
v 4 300 100
v 5 200 200

# Cubic Bézier — classic S-curve
e 0 0 2 type=cubic 100 -60 300 60

# Quadratic Bézier — simple arc
e 1 3 5 type=quad 200 50

# Straight segment
e 2 1 4

# Catmull-Rom (auto-smooth through vertices)
e 3 0 3 type=catmull
e 4 3 5 type=catmull
e 5 5 2 type=catmull

# Stroke on cubic (tapered)
s 0 0 0000FF 1.0 4.0 6.0 4.0 1.0

# Stroke on quadratic (constant)
s 1 1 FF0000 3.0 3.0

# Stroke on segment
s 2 2 00AA00 2.0 2.0

# Ellipse primitive
z 0 200 150 80 40 0.3 F0F0FF 333333 2.0

# Arc primitive
r 0 200 150 60 0 270 884400 1.5
