# dialect fixture (authoring skin v1.6.2)
# exercises: symbolic ids, e/s by name, path, group, fobj (seg + catmull,
# fill-only sw=0), ghost splice (useg), mixed named/numeric records.
v origin 40 40
v tip 180 40
e bar origin tip
s barS bar 000000FF 4 4 cap=round

path spine seg 60,60 60,110
path zig catmull w=3 cap=round color=112233 400,20 430,60 405,100 435,140

group left
path arcL seg w=3 cap=round 60,110 30,140 42,180
fobj blob fill=FFEEDD sw=2.5 cap=round seg 220,60 300,52 340,96 310,150 238,146

group right
fobj halo fill=FFCCCC sw=0 catmull 120,160 150,140 180,160 180,196 150,212 120,196
fobj tail fill=FFFFFF sw=3 seg 60,60 useg spine 90,80 118,96

# named records mixed with plain numeric Line-ASM afterwards
# (numeric ids live in their own space: pick them above any symbol counter)
v 900 380 200
v 901 440 200
e 900 900 901
s 900 900 FF8800 6 6 cap=round
